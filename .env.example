# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB URI)
MONGO_URI=mongodb://127.0.0.1:27017/ecolink

# Security & Secret Keys (Replace with a strong random secret key in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173
